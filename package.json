{
  "name": "skill-preflight",
  "version": "0.8.0",
  "description": "Pre-install safety, token, and maintainability scorecard for AI agent skills.",
  "type": "module",
  "bin": {
    "skill-preflight": "dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "skills",
    "assets/skill-preflight-avatar.png",
    "assets/skill-preflight-avatar.svg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "benchmark:public": "npm run build && node scripts/benchmark-public-skills.mjs",
    "dev": "npm run build && node dist/index.js",
    "test": "npm run build && node --test test/scan.test.mjs",
    "test:coverage": "npm run build && node --experimental-test-coverage --test test/scan.test.mjs",
    "scan:good": "npm run build && node dist/index.js scan examples/good-skill",
    "scan:risky": "npm run build && node dist/index.js scan examples/risky-skill",
    "prepack": "npm run build"
  },
  "keywords": [
    "agent",
    "skills",
    "security",
    "scanner",
    "agent-skills",
    "skill-md",
    "static-analysis",
    "token-efficiency",
    "codex",
    "claude",
    "mcp",
    "llm"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-contracts/skill-preflight.git"
  },
  "bugs": {
    "url": "https://github.com/agent-contracts/skill-preflight/issues"
  },
  "homepage": "https://github.com/agent-contracts/skill-preflight#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "tar": "^7.5.22",
    "undici": "^6.28.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  }
}
